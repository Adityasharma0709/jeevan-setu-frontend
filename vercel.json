{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jeevan-setu-frontend.vercel.app"
        }
      ],
      "destination": "https://www.jeevansetu.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "http://ec2-13-205-166-85.ap-south-1.compute.amazonaws.com:3000/:path*"
    }
  ]
}
