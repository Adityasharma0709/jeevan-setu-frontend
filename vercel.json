{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jeevan-setu-frontend.vercel.app"
        }
      ],
      "destination": "https://www.jeevansetu.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jeevansetu.org"
        }
      ],
      "destination": "https://www.jeevansetu.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}